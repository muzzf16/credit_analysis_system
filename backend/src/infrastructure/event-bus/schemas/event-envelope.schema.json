{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventEnvelope",
  "description": "Canonical event envelope structure for the domain event system. All events flowing through the Event Bus MUST conform to this schema.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event"
    },
    "eventType": {
      "type": "string",
      "description": "The domain event type (e.g., 'ApplicationSubmitted', 'CreditCaseBuilt')"
    },
    "eventVersion": {
      "type": "string",
      "description": "Schema version of this event type for forward-compatibility",
      "default": "1.0"
    },
    "aggregate": {
      "type": "string",
      "description": "The aggregate name (e.g., 'Application', 'Case', 'Assessment')"
    },
    "aggregateId": {
      "type": "string",
      "description": "The aggregate instance identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of event creation"
    },
    "correlationId": {
      "type": "string",
      "description": "Root trace ID — same for all events in a single workflow chain"
    },
    "causationId": {
      "type": ["string", "null"],
      "description": "The eventId of the parent event that directly caused this one. Null for root events."
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data payload"
    },
    "metadata": {
      "type": "object",
      "description": "Audit and traceability metadata",
      "properties": {
        "pipelineFingerprint": { "type": "string" },
        "builderVersion": { "type": "string" },
        "policyVersion": { "type": "string" },
        "workflowStep": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregate",
    "aggregateId",
    "timestamp",
    "correlationId",
    "payload",
    "metadata"
  ],
  "additionalProperties": false
}
