{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisPackage",
  "description": "Immutable package for AI Credit Analyst — frozen facts, decision, and context",
  "type": "object",
  "required": [
    "packageId",
    "assessmentId",
    "decisionKernel",
    "factCollection",
    "capabilityCollection",
    "intent",
    "policy",
    "fingerprint",
    "createdAt",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "packageId": { "type": "string", "minLength": 1 },
    "assessmentId": { "type": "string", "minLength": 1 },
    "decisionKernel": { "type": "object" },
    "factCollection": { "type": "object" },
    "capabilityCollection": { "type": "object" },
    "intent": { "type": "object" },
    "policy": { "type": "object" },
    "fingerprint": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "default": "1.0.0" }
  }
}