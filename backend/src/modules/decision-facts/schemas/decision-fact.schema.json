{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionFact Schema",
  "type": "object",
  "properties": {
    "code": { "type": "string" },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "derivedFrom": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reasonCodes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["code", "value", "derivedFrom", "reasonCodes"],
  "additionalProperties": false
}
