{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionIntent Definition Schema",
  "type": "object",
  "properties": {
    "code": { "type": "string" },
    "allowedRecommendations": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "allowedRiskLevels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "required": ["code", "allowedRecommendations", "allowedRiskLevels"],
  "additionalProperties": false
}
