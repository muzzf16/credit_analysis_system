{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionIntent Schema",
  "type": "object",
  "properties": {
    "code": { "type": "string" },
    "recommendation": { "type": "string" },
    "riskLevel": { "type": "string" },
    "authority": { "type": "string" },
    "manualReview": { "type": "boolean" },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string" },
          "source": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["code", "severity", "source", "description"],
        "additionalProperties": false
      }
    },
    "derivedFrom": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["code", "recommendation", "riskLevel", "authority", "manualReview", "conditions", "derivedFrom"],
  "additionalProperties": false
}
