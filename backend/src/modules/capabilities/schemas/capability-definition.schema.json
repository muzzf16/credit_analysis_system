{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Capability Definition Schema",
  "type": "object",
  "properties": {
    "code": { "type": "string" },
    "name": { "type": "string" },
    "allowedStatuses": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "description": { "type": "string" }
  },
  "required": ["code", "name", "allowedStatuses", "description"],
  "additionalProperties": false
}
