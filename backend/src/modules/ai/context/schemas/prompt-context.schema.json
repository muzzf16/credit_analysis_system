{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromptContext",
  "description": "AI View Model — optimized representation of AnalysisPackage for prompt generation",
  "type": "object",
  "required": ["packageId", "summary", "risk", "facts", "capabilities", "recommendation", "conditions", "authority"],
  "additionalProperties": false,
  "properties": {
    "packageId": { "type": "string" },
    "summary": {
      "type": "object",
      "properties": {
        "decisionId": { "type": "string" },
        "assessmentId": { "type": "string" },
        "recommendation": { "type": "string" },
        "riskLevel": { "type": "string" }
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": { "type": "string" },
        "factors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "facts": { "type": "object" },
    "capabilities": { "type": "object" },
    "recommendation": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "code": { "type": "string" },
        "riskLevel": { "type": "string" }
      }
    },
    "conditions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "authority": {
      "type": "object",
      "properties": {
        "required": { "type": "string" },
        "resolvedBy": { "type": "string" }
      }
    },
    "appendix": { "type": "object" },
    "borrower": { "type": "object" }
  }
}