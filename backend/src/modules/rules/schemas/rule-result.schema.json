{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule Result Schema",
  "type": "object",
  "properties": {
    "code": { "type": "string" },
    "passed": { "type": "boolean" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "value": { "type": ["number", "string", "boolean", "null"] }
        },
        "required": ["code", "value"]
      }
    },
    "reasonCodes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["code", "passed", "metrics", "reasonCodes"],
  "additionalProperties": false
}
