{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule Metadata Schema",
  "type": "object",
  "properties": {
    "code": { "type": "string" },
    "category": { 
      "type": "string",
      "enum": ["ELIGIBILITY", "FINANCIAL", "COLLATERAL", "COMPLIANCE", "SCORING"]
    },
    "version": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of formula codes this rule depends on"
    }
  },
  "required": ["code", "category", "version", "severity"],
  "additionalProperties": false
}
