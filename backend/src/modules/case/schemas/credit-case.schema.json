{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreditCase",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string"
    },
    "revisionId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "application": { "type": "object" },
        "debitur": { "type": ["object", "null"] },
        "agunan": { 
          "type": "array",
          "items": { "type": "object" }
        },
        "creditExposure": { "type": ["object", "null"] }
      },
      "required": ["application", "agunan"]
    },
    "sources": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "engine": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "verified": { "type": "boolean" }
        },
        "required": ["source", "engine", "confidence", "verified"]
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "completeness": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "verification": { "type": "string" }
        },
        "required": ["completeness", "confidence", "verification"]
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "applicationId": { "type": "string" },
        "pipelineFingerprint": { "type": "string" },
        "builderVersion": { "type": "string" },
        "createdFromEvents": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["applicationId", "pipelineFingerprint", "builderVersion", "createdFromEvents"]
    },
    "integrity": {
      "type": "object",
      "properties": {
        "hash": { "type": "string" },
        "algorithm": { "type": "string", "enum": ["SHA-256"] }
      },
      "required": ["hash", "algorithm"]
    }
  },
  "required": [
    "caseId", 
    "revisionId", 
    "revision", 
    "data", 
    "sources", 
    "provenance", 
    "quality", 
    "trace", 
    "integrity"
  ],
  "additionalProperties": false
}
